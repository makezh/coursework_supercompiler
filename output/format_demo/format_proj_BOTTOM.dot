digraph ProcessTree {
  label="Expression: idnat\nWhistle Strategy: HE | Gen Type: BOTTOM";
  labelloc="t";
  fontsize=20;
  fontname="Arial";

    node [fontname="Courier New"];
    edge [fontname="Courier New"];
    start [label="(idnat x1)", shape=box, style="filled", fillcolor="lightgreen", color="darkgreen", penwidth=2.0];
    start -> n0 [];
    n0 [label="(PROGRAM_FOREST )", shape=box];
    n0 -> n1 [label=""];
    n1 [label="x1\nfmt: x1", shape=box];
}
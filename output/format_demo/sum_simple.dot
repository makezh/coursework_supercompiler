digraph ProcessTree {
  label="Expression: main\nWhistle Strategy: HE | Gen Type: BOTTOM";
  labelloc="t";
  fontsize=20;
  fontname="Arial";

    node [fontname="Courier New"];
    edge [fontname="Courier New"];
    start [label="(main x1)", shape=box, style="filled", fillcolor="lightgreen", color="darkgreen", penwidth=2.0];
    start -> n0 [];
    n0 [label="(PROGRAM_FOREST )", shape=box];
    n0 -> n1 [label=""];
    n1 [label="(sum x1 [S [S [Z]]])\nfmt: [S [S v1]]", shape=box];
    n1 -> n2 [label="x1 -> [Z]"];
    n1 -> n3 [label="x1 -> [S v1]"];
    n2 [label="[S [S [Z]]]", shape=box];
    n2 -> n4 [label=""];
    n3 [label="[S (sum v1 [S [S [Z]]])]", shape=box];
    n3 -> n5 [label=""];
    n4 [label="[S [Z]]", shape=box];
    n4 -> n6 [label=""];
    n5 [label="(sum v1 [S [S [Z]]])", shape=box];
    n5 -> n1 [style=dashed, color=red, label="Folding"];
    n6 [label="[Z]", shape=box];
}
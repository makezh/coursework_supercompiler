digraph ProcessTree {
  label="Expression: pick\nWhistle Strategy: HE | Gen Type: BOTTOM";
  labelloc="t";
  fontsize=20;
  fontname="Arial";

    node [fontname="Courier New"];
    edge [fontname="Courier New"];
    start [label="(pick x1 x2)", shape=box, style="filled", fillcolor="lightgreen", color="darkgreen", penwidth=2.0];
    start -> n0 [];
    n0 [label="(PROGRAM_FOREST )", shape=box];
    n0 -> n1 [label=""];
    n1 [label="(pick x1 x2)\nfmt: [S v1]", shape=box];
    n1 -> n2 [label="x1 -> [True]"];
    n1 -> n3 [label="x1 -> [False]"];
    n2 [label="[S [Z]]", shape=box];
    n2 -> n4 [label=""];
    n3 [label="[S x2]", shape=box];
    n3 -> n5 [label=""];
    n4 [label="[Z]", shape=box];
    n5 [label="x2", shape=box];
}
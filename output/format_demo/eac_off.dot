digraph ProcessTree {
  label="Expression: main\nWhistle Strategy: HE | Gen Type: BOTTOM";
  labelloc="t";
  fontsize=20;
  fontname="Arial";

    node [fontname="Courier New"];
    edge [fontname="Courier New"];
    start [label="(main x1 x2)", shape=box, style="filled", fillcolor="lightgreen", color="darkgreen", penwidth=2.0];
    start -> n0 [];
    n0 [label="(PROGRAM_FOREST )", shape=box];
    n0 -> n1 [label=""];
    n0 -> n2 [label=""];
    n1 [label="[Cons (even x1) [Cons x2 [Nil]]]", shape=box];
    n1 -> n3 [label=""];
    n1 -> n4 [label=""];
    n2 [label="(even x1)", shape=box];
    n2 -> n5 [label="x1 -> [Z]"];
    n2 -> n6 [label="x1 -> [S [Z]]"];
    n2 -> n7 [label="x1 -> [S [S v6]]"];
    n3 [label="(even x1)", shape=box, style="filled", fillcolor="lightcyan", color="blue", penwidth=2.0];
    n4 [label="[Cons x2 [Nil]]", shape=box];
    n4 -> n8 [label=""];
    n4 -> n9 [label=""];
    n5 [label="[Z]", shape=box];
    n6 [label="[Z]", shape=box];
    n7 [label="[S (even v6)]", shape=box];
    n7 -> n10 [label=""];
    n8 [label="x2", shape=box];
    n9 [label="[Nil]", shape=box];
    n10 [label="(even v6)", shape=box];
    n10 -> n2 [style=dashed, color=red, label="Folding"];
}
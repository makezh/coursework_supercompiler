digraph ProcessTree {
  label="Expression: wrapS\nWhistle Strategy: HE | Gen Type: BOTTOM";
  labelloc="t";
  fontsize=20;
  fontname="Arial";

    node [fontname="Courier New"];
    edge [fontname="Courier New"];
    start [label="(wrapS x1 x2)", shape=box, style="filled", fillcolor="lightgreen", color="darkgreen", penwidth=2.0];
    start -> n0 [];
    n0 [label="(PROGRAM_FOREST )", shape=box];
    n0 -> n1 [label=""];
    n1 [label="[S x1]\nfmt: [S #x1]", shape=box];
    n1 -> n2 [label=""];
    n2 [label="x1", shape=box];
}